# kumo-good relayer configuration. Copy to `.env` and fill in.
# With no RELAYER_PK the relayer runs in DRY-RUN mode (simulates, never submits) —
# perfect for local development without a funded key.

# GoodDollar environment: production | staging | development (default production)
GD_ENV=production

# Chain + RPC. Default is Celo mainnet. For a free local fork, run a forked node
# (e.g. `hardhat node --fork https://forno.celo.org`) and point here:
#   CHAIN_ID=31337
#   CELO_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=42220
CELO_RPC_URL=https://forno.celo.org

# Funded relayer signer (NEVER commit a real key). Leave blank for dry-run.
# RELAYER_PK=0x...

# Gas fee currency. Defaults to cUSD on mainnet, native CELO on a fork.
# cUSD: 0x765DE816845861e75A25fCA122bb6898B8B1282a
# FEE_CURRENCY=0x765DE816845861e75A25fCA122bb6898B8B1282a

# HTTP
PORT=8787
ALLOW_ORIGIN=*
