# kumo-good web app. Copy to `.env.local`.

# Where the browser's same-origin /api/relay proxy forwards to (server-side only).
RELAYER_URL=http://127.0.0.1:8787

# Chain the browser reads from. Default = Celo mainnet (real G$/Identity/UBI).
# For a free local fork: NEXT_PUBLIC_CHAIN_ID=42220 + NEXT_PUBLIC_CELO_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_GD_ENV=production
NEXT_PUBLIC_CHAIN_ID=42220
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org
# NEXT_PUBLIC_G_TOKEN=0x62B8B11039FcfE5aB0C56E502b1C372A3d2a9c7A
